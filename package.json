{
  "name": "atlas-wealth",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:migrate": "drizzle-kit migrate",
    "db:setup": "node --import tsx scripts/setup-local-db.ts && node --import tsx scripts/seed.ts",
    "keychain:store": "bash ./scripts/keychain-store-database-url.sh",
    "keychain:sync-github": "bash ./scripts/sync-keychain-to-github.sh",
    "lint": "eslint",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 node --import tsx --test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:local": "bash ./scripts/e2e/run-local.sh"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.33.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.563.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.26"
  }
