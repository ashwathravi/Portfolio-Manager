# Database. Local development uses the Docker Postgres from docker-compose.yml
# (npm run db:up, then npm run db:setup). Never point local dev at Supabase:
# that project is production.
#
# DATABASE_URL is the app's login: a least-privilege role that is a member of
# app_runtime (migration 0010). DATABASE_MIGRATION_URL is the table owner and is
# used only by migrations and db:setup.
DATABASE_URL="postgres://atlas_app:atlas-app-local-only@127.0.0.1:54329/atlas_wealth"
DATABASE_MIGRATION_URL="postgres://atlas:atlas-local-only@127.0.0.1:54329/atlas_wealth"
#
# Production (set in Vercel and GitHub secrets, never in a file):
#   DATABASE_URL            Supabase transaction pooler (port 6543), user atlas_app.<project-ref>
#   DATABASE_MIGRATION_URL  Supabase session pooler (port 5432), user postgres.<project-ref>

# Auth.js Google OAuth. Create credentials in Google Cloud Console with
# redirect URI: http://localhost:3000/api/auth/callback/google
# Setting all three turns on Google sign-in and turns off the local bypass.
# AUTH_SECRET="replace-with-auth-secret"
# AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
# AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"
# Local only (ignored in production): sign in as this user without Google.
# db:setup creates the user.
AUTH_LOCAL_DEV_BYPASS="1"
AUTH_LOCAL_DEV_USER_ID="00000000-0000-4000-8000-00000000d001"
# Invite list. Required in production: without either list, production
# refuses to start sign-in (503) rather than letting any Google account in.
# Comma-separated. When both are set, a person must match both.
# Use AUTH_ALLOWED_DOMAINS only with Google Workspace `hd` claims.
# AUTH_ALLOWED_EMAILS="you@example.com"
# AUTH_ALLOWED_DOMAINS="example.com"
# Who may change Alpha Radar's tracked filers and refresh them from SEC
# EDGAR, which every user shares. Nobody when unset; the local bypass user
# always may.
# AUTH_ADMIN_EMAILS="you@example.com"

# Public URL and key for client-side auth/realtime if needed later.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# Market data: a Massive (formerly Polygon.io) Basic key, free at massive.com.
# Basic has end-of-day prices, two years of daily history and 5 calls a
# minute. The nightly ingest stores closing prices in Postgres and quotes are
# read from there, so pages never spend that limit. Without a key the app
# still runs: pages show the stored price or "—", and history, fundamentals
# and search answer 503 MARKET_DATA_NOT_CONFIGURED.
# POLYGON_API_KEY=""
# Optional: defaults to https://api.polygon.io
# POLYGON_BASE_URL=""

# Plaid Link account discovery. Use sandbox credentials for local development.
PLAID_ENV="sandbox"
PLAID_CLIENT_ID="replace-with-plaid-client-id"
PLAID_SECRET="replace-with-plaid-secret"
PLAID_PRODUCTS="investments,transactions"
PLAID_COUNTRY_CODES="US"

# Local dev can use the encrypted file vault. Production uses postgres and
# requires PLAID_TOKEN_ENCRYPTION_KEY (no other secret is used in its place).
# Syncing linked accounts into portfolios needs postgres here too: the file
# vault keeps only the token, not the connection to sync.
# PLAID_TOKEN_STORAGE="postgres"
# 32 random bytes, base64 or hex: openssl rand -base64 32. Production
# refuses a shorter or guessable key and stores no tokens until it's fixed.
# PLAID_TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-or-hex-key"
# PLAID_TOKEN_KEY_VERSION="v1"
# PLAID_CLIENT_NAME="Atlas Wealth"
# PLAID_REDIRECT_URI=""
# Plaid's webhooks (new holdings or transactions, sign in again, consent
# ending, revoked) go to /api/plaid/webhook; set it on the deployed origin,
# e.g. https://<your-domain>/api/plaid/webhook. Only connections linked
# after it is set get webhooks; the nightly sync covers the rest.
# PLAID_WEBHOOK_URL=""

# Shared rate limiting (Upstash Redis via the Vercel Marketplace). Vercel sets
# these for every environment; `vercel env pull` brings them into .env.local.
# Keys are namespaced per environment (and per preview branch), so local runs
# and previews never touch production's counters. Without a complete URL and
# token pair, each server process keeps its own in-memory limits.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# Scheduled jobs. Vercel Cron calls /api/cron/daily (vercel.json) with
# "Authorization: Bearer $CRON_SECRET". Without it the route refuses every
# call (503) and no job runs. Generate a value (openssl rand -hex 32) and set
# it in Vercel for Production only; locally, only to call the route by hand:
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/daily
# CRON_SECRET=""

# Error monitoring (Sentry via the Vercel Marketplace). The integration sets
# these for Production and Preview; leave them unset locally so the SDK never
# starts and nothing is reported. Vercel's own build uploads source maps with
# the auth token; SENTRY_RELEASE (the commit) is passed in by the deploy job.
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# Server-to-server calls (bearer token or x-api-key) to non-user API routes.
# It identifies a service, never a user: user-scoped routes need a session.
# INTERNAL_API_SECRET=""

# Schwab OAuth and order routes are not production-ready and stay off unless
# this is "1". They never run in production.
# SCHWAB_INTEGRATION_ENABLED="0"
