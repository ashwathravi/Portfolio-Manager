# Database. Local development uses the Docker Postgres from docker-compose.yml
# (npm run db:up, then npm run db:setup). Never point local dev at Supabase:
# that project is production.
#
# DATABASE_URL is the app's login: a least-privilege role that is a member of
# app_runtime (migration 0010). DATABASE_MIGRATION_URL is the table owner and is
# used only by migrations and db:setup.
DATABASE_URL="postgres://atlas_app:atlas-app-local-only@127.0.0.1:54329/atlas_wealth"
DATABASE_MIGRATION_URL="postgres://atlas:atlas-local-only@127.0.0.1:54329/atlas_wealth"
#
# Production (set in Vercel and GitHub secrets, never in a file):
#   DATABASE_URL            Supabase transaction pooler (port 6543), user atlas_app.<project-ref>
#   DATABASE_MIGRATION_URL  Supabase session pooler (port 5432), user postgres.<project-ref>

# Auth.js Google OAuth. Create credentials in Google Cloud Console with
# redirect URI: http://localhost:3000/api/auth/callback/google
# Setting all three turns on Google sign-in and turns off the local bypass.
# AUTH_SECRET="replace-with-auth-secret"
# AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
# AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"
# Local only (ignored in production): sign in as this user without Google.
# db:setup creates the user.
AUTH_LOCAL_DEV_BYPASS="1"
AUTH_LOCAL_DEV_USER_ID="00000000-0000-4000-8000-00000000d001"
# Optional workspace restrictions. Prefer AUTH_ALLOWED_EMAILS for personal
# deployments; use AUTH_ALLOWED_DOMAINS only with Google Workspace `hd` claims.
# AUTH_ALLOWED_EMAILS="you@example.com"
# AUTH_ALLOWED_DOMAINS="example.com"

# Public URL and key for client-side auth/realtime if needed later.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# Optional: Alpha Vantage fallback market data provider. Free key at
# https://www.alphavantage.co/support/#api-key - leave unset to disable.
# ALPHA_VANTAGE_API_KEY=""

# Plaid Link account discovery. Use sandbox credentials for local development.
PLAID_ENV="sandbox"
PLAID_CLIENT_ID="replace-with-plaid-client-id"
PLAID_SECRET="replace-with-plaid-secret"
PLAID_PRODUCTS="investments,transactions"
PLAID_COUNTRY_CODES="US"

# Local dev can use the encrypted file vault. Production should use postgres
# with a managed secret value for PLAID_TOKEN_ENCRYPTION_KEY.
# PLAID_TOKEN_STORAGE="postgres"
# PLAID_TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-or-hex-key"
# PLAID_TOKEN_KEY_VERSION="v1"
# PLAID_CLIENT_NAME="Atlas Wealth"
# PLAID_REDIRECT_URI=""
# PLAID_WEBHOOK_URL=""
